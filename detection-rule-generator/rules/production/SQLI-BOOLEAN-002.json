{
  "code": "SQLI-BOOLEAN-002",
  "name": "String equality tautology",
  "category": "SQLI",
  "pattern": "(?i)(\\bor\\b|\\band\\b)(?:\\s+|%20|\\+)*(?:'|%27)[^']{0,32}(?:'|%27)(?:\\s+|%20|\\+)*(?:=|%3d)(?:\\s+|%20|\\+)*(?:'|%27)",
  "target_field": "query",
  "weight": 40,
  "enabled": true,
  "description": "Detects quoted string tautologies such as OR 'a'='a' in query values.",
  "source": "AI_MINED",
  "generator_rule_id": "SQLI-BOOLEAN-002",
  "rule_version": "1.0.0"
